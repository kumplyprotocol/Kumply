# avalanche-starter-kit ships with no LICENSE file: treat as read-only
# reference, never copy its code verbatim. See SETUP.md.
.claude/skills/avalanche-skills/
.reference/

# ── IDE / OS ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Misc ────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
.vercel
.turbo

.vercel
CLAUDE.md
claude.md
Memory.md

# ── Internal / not for public repo ──────────────────────────────
LEGAL_REVIEW_BRIEF.md
LEGAL_*.md
INTERNAL_*.md
# Grant/submission drafts + operational runbooks — live in kumplyprotocol/internal
docs/submissions/
docs/internal/
claude_estrategico.md

