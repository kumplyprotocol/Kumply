node_modules/
.pnpm-store/

# ── Environment / Secrets ───────────────────────────────────────
.env
.env.local
.env.production
.env.*.local

# ── Build outputs ───────────────────────────────────────────────
dist/
.next/
out/
build/

# ── Hardhat / Solidity ──────────────────────────────────────────
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
coverage/
coverage.json

# ── Avalanche reference tooling (project-scoped, dev-only) ─────
